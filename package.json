{
  "name": "philosopher-cafe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_USE_ENV_PROXY=1 next dev",
    "build": "npm run index && cross-env NODE_USE_ENV_PROXY=1 next build",
    "start": "cross-env NODE_USE_ENV_PROXY=1 next start",
    "lint": "next lint",
    "index": "cross-env NODE_USE_ENV_PROXY=1 tsx scripts/build-index.ts",
    "typecheck": "tsc --noEmit",
    "eval": "cross-env NODE_USE_ENV_PROXY=1 tsx scripts/eval-retrieve.ts",
    "eval:contract": "tsx scripts/run-evals.ts",
    "fetch": "cross-env NODE_USE_ENV_PROXY=1 tsx scripts/fetch-corpus.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:turn": "tsx scripts/smoke-turn-plan.ts",
    "test:retrieve": "cross-env NODE_USE_ENV_PROXY=1 tsx scripts/smoke-retrieve.ts",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:performance": "node scripts/performance-audit.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
