# 必填：Claude API key（对话 + 视觉识别菜品）
ANTHROPIC_API_KEY=sk-ant-...

# 可选：Voyage AI key。设置后 build-index 会额外生成向量，
# 检索从「纯 BM25」升级为「BM25 + 向量」的混合检索（RRF 融合）。
# 不设置也能完整跑通，只是长句语义检索弱一些。
# VOYAGE_API_KEY=pa-...

# 可选：覆盖默认模型
# CAFE_MODEL=claude-opus-5

# 强烈建议线上设置：Upstash Redis（免费档够用）。
# 有它，限流计数在所有函数实例间共享；没有它，退回进程内存，只挡得住突发。
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# 可选：限流额度（默认值见 src/lib/ratelimit.ts）
# CAFE_RL_CHAT=30        每 IP 每 10 分钟对话次数
# CAFE_RL_DISH=10        每 IP 每 10 分钟拍照识别次数
# CAFE_DAILY_CHAT=400    全站每日对话上限
# CAFE_DAILY_DISH=80     全站每日识别上限
